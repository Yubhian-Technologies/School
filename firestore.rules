rules_version = '2';

// =============================================================================
// EXTENDING THIS FILE
//
// Goal: adding a new collection should never require editing an existing
// match block. Two registries below cover the two repeating shapes in this
// schema — extend those in place of writing new blocks when the shape fits:
//
//   1. SCHOOL_SCOPED_ADMIN_COLLECTIONS — read: any signed-in user of the same
//      school; write: admin of that school only. (e.g. circulars, events,
//      activities, transportBuses, feeStructures, classSections,
//      facultyAssignments.) To add one: append its name to the list in
//      isSchoolScopedAdminCollection() below. Nothing else changes. NOTE:
//      only safe for a collection that's never read via a direct get() on a
//      doc id that might not exist — this bucket's read rule always touches
//      resource.data with no null-resource fallback (see holidays below for
//      why that matters, and the "Firestore gotchas" note in CLAUDE.md).
//
//   2. PARENT_REVIEWED_REQUEST_COLLECTIONS — parent creates a doc scoped by
//      (schoolId, classSectionId, studentId, parentUid, status: 'pending');
//      Class Teacher or Admin reviews (update/delete); parent can read their
//      own. (e.g. parentRequests, leaveRequests.) To add one: append its name
//      to isParentReviewedRequestCollection() below.
//
// If a new collection's permissions don't fit either shape, add a brand-new
// `match /<name>/{id} { ... }` block using the helper functions in the
// Helpers section — do not modify an existing block to shoehorn in new logic.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // -----------------------------------------------------------------------
    // Helpers
    // -----------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function myProfile() {
      return userDoc(request.auth.uid).data;
    }

    function myRole() {
      return myProfile().role;
    }

    function mySchool() {
      return myProfile().schoolId;
    }

    function isSuperAdmin() {
      return isSignedIn() && myRole() == 'superadmin';
    }

    function isAdmin() {
      return isSignedIn() && myRole() == 'admin';
    }

    function isAdminOfSchool(schoolId) {
      return isAdmin() && mySchool() == schoolId;
    }

    function isFaculty() {
      return isSignedIn() && myRole() == 'faculty';
    }

    function isFacultyOfSchool(schoolId) {
      return isFaculty() && mySchool() == schoolId;
    }

    function isParent() {
      return isSignedIn() && myRole() == 'parent';
    }

    function isParentOfSchool(schoolId) {
      return isParent() && mySchool() == schoolId;
    }

    function inSameSchool(schoolId) {
      return isSignedIn() && mySchool() == schoolId;
    }

    function classSectionDoc(classSectionId) {
      return get(/databases/$(database)/documents/classSections/$(classSectionId));
    }

    // classSections/{id}.classTeacherUid (set by Admin via the Classes &
    // Sections module) is the real, populated source of class-teacher
    // assignment. (An earlier design read a classSectionRoles map off the
    // faculty doc instead — nothing ever wrote that field, so every check
    // built on it silently denied every real faculty account. Removed.)
    function isClassTeacherOf(classSectionId) {
      return isFaculty() && classSectionDoc(classSectionId).data.classTeacherUid == request.auth.uid;
    }

    // Interim stand-in for "is this faculty a Subject Teacher of
    // classSectionId": there's no real per-subject assignment data yet (see
    // CLAUDE.md "known debts"), so any faculty of the same school as the
    // class-section counts. Tighten once subject-teacher assignments exist.
    function isAnyTeacherOf(classSectionId) {
      return isFaculty() && isFacultyOfSchool(classSectionDoc(classSectionId).data.schoolId);
    }

    // Real per-subject assignment check, backed by an Admin-managed
    // facultyAssignments/{classSectionId}_{subjectId} doc (see
    // components/SubjectTeacherAssignments.tsx). Used to gate who may write
    // an assignments/{id} diary entry — tighter than isAnyTeacherOf above.
    function facultyAssignmentDoc(classSectionId, subjectId) {
      return get(/databases/$(database)/documents/facultyAssignments/$(classSectionId + '_' + subjectId));
    }

    function isSubjectTeacherOf(classSectionId, subjectId) {
      return isFaculty() && facultyAssignmentDoc(classSectionId, subjectId).data.facultyUid == request.auth.uid;
    }

    function studentDoc(studentId) {
      return get(/databases/$(database)/documents/students/$(studentId));
    }

    function isGuardianOf(studentId) {
      return isParent() && request.auth.uid in studentDoc(studentId).data.guardianUids;
    }

    function isParentLinkedToClass(classSectionId) {
      return isParent() &&
        exists(/databases/$(database)/documents/parentClassLinks/$(request.auth.uid + '_' + classSectionId));
    }

    // -----------------------------------------------------------------------
    // Extensible registries — see "EXTENDING THIS FILE" note at the top.
    // -----------------------------------------------------------------------

    function isSchoolScopedAdminCollection(name) {
      return name in [
        'circulars', 'events', 'activities', 'transportBuses',
        'feeStructures', 'classSections', 'facultyAssignments', 'subjects'
      ];
    }

    function isParentReviewedRequestCollection(name) {
      return name in ['parentRequests', 'leaveRequests'];
    }

    // Bucket 1: same-school read, admin-of-school write. New members: add the
    // collection name to isSchoolScopedAdminCollection() above, nothing else.
    // Deliberately does NOT have a `resource == null` fallback — this bucket
    // is read via `list` queries everywhere (Subjects, Classes & Sections,
    // Faculty's subject assignments, Transport, Timetable...), and mixing a
    // null-resource branch into a rule alongside the query-provable
    // resource.data branch isn't something to gamble on here without a live
    // Firestore rules simulator to confirm the `list` provability check
    // still reduces correctly for every existing member. A collection that's
    // read via direct get() on an id that might not exist (feeStructures
    // before an admin configures a class's fees, holidays before a date is
    // declared) needs its own dedicated block instead — see holidays below.
    match /{collection}/{id} {
      allow read: if isSchoolScopedAdminCollection(collection) && inSameSchool(resource.data.schoolId);
      allow create, update: if isSchoolScopedAdminCollection(collection) &&
        isAdminOfSchool(request.resource.data.schoolId);
      // delete has no request.resource (there's no new document state), so
      // it must check the existing doc via resource.data, not
      // request.resource.data — using request.resource.data here would
      // always deny the delete. Same fix applied throughout this file.
      allow delete: if isSchoolScopedAdminCollection(collection) &&
        isAdminOfSchool(resource.data.schoolId);
    }

    // Bucket 2: parent-submitted, Class-Teacher/Admin-reviewed requests. New
    // members: add the collection name to isParentReviewedRequestCollection().
    match /{collection}/{id} {
      allow read: if isParentReviewedRequestCollection(collection) && (
        isAdminOfSchool(resource.data.schoolId) ||
        isClassTeacherOf(resource.data.classSectionId) ||
        request.auth.uid == resource.data.parentUid
      );

      allow create: if isParentReviewedRequestCollection(collection) &&
        isGuardianOf(request.resource.data.studentId) &&
        request.resource.data.parentUid == request.auth.uid &&
        request.resource.data.status == 'pending';

      allow update: if isParentReviewedRequestCollection(collection) && (
        isAdminOfSchool(resource.data.schoolId) ||
        isClassTeacherOf(resource.data.classSectionId)
      );

      allow delete: if isParentReviewedRequestCollection(collection) && isAdminOfSchool(resource.data.schoolId);
    }

    // -----------------------------------------------------------------------
    // users/{uid} — the trust anchor read by every login. Self-get must always
    // succeed for every role, since it's the very first Firestore call after
    // signInWithEmailAndPassword.
    // -----------------------------------------------------------------------

    match /users/{uid} {
      // The parent-of-school branch lets a faculty member read a parent's
      // login email (only) — needed so a class teacher can view/backfill
      // the "Student Login" email shown on a student's profile, for
      // students created before that email was denormalized onto the
      // students doc itself. Scoped to role == 'parent' so faculty can never
      // read another faculty/admin's user doc this way.
      allow get: if isSignedIn() && (
        request.auth.uid == uid ||
        isSuperAdmin() ||
        (isAdmin() && resource.data.schoolId == mySchool()) ||
        (isFacultyOfSchool(resource.data.schoolId) && resource.data.role == 'parent')
      );

      allow list: if isSuperAdmin() ||
        (isAdmin() && resource.data.schoolId == mySchool());

      allow create: if
        (isSuperAdmin() && request.resource.data.role == 'admin') ||
        (isAdmin() &&
          request.resource.data.role in ['faculty', 'parent'] &&
          request.resource.data.schoolId == mySchool()) ||
        // A Class Teacher creates a parent login as part of Add Student.
        // Not scoped to "is this faculty actually a class teacher somewhere"
        // — that can't be checked here (no classSectionId on a users doc to
        // resolve it from) — but the login is useless without a matching
        // students/{id} write, which IS scoped to the real class teacher via
        // isClassTeacherOf() below. Faculty can never create admin/faculty
        // accounts this way, only parent ones.
        (isFaculty() &&
          request.resource.data.role == 'parent' &&
          request.resource.data.schoolId == mySchool());

      allow update: if
        (request.auth.uid == uid &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.schoolId == resource.data.schoolId &&
          request.resource.data.status == resource.data.status) ||
        isSuperAdmin() ||
        (isAdmin() && resource.data.schoolId == mySchool() &&
          request.resource.data.schoolId == resource.data.schoolId &&
          request.resource.data.role == resource.data.role);

      allow delete: if isSuperAdmin() ||
        (isAdmin() && resource.data.schoolId == mySchool() && resource.data.role in ['faculty', 'parent']);
    }

    // -----------------------------------------------------------------------
    // schools/{id}
    // -----------------------------------------------------------------------

    match /schools/{schoolId} {
      allow read: if isSuperAdmin() || inSameSchool(schoolId);
      allow create, update, delete: if isSuperAdmin();
    }

    // -----------------------------------------------------------------------
    // faculty/{uid} — profile doc id == auth uid
    // -----------------------------------------------------------------------

    match /faculty/{uid} {
      allow read: if isSignedIn() && (
        request.auth.uid == uid ||
        isAdminOfSchool(resource.data.schoolId) ||
        inSameSchool(resource.data.schoolId) // any school user may view a faculty directory profile
      );

      allow create: if isAdminOfSchool(request.resource.data.schoolId);
      allow delete: if isAdminOfSchool(resource.data.schoolId);

      allow update: if
        isAdminOfSchool(resource.data.schoolId) ||
        (request.auth.uid == uid &&
          request.resource.data.schoolId == resource.data.schoolId);
    }

    // facultyAssignments/{id}, classSections/{id} and subjects/{id} are
    // handled by the isSchoolScopedAdminCollection() bucket above.

    match /parentClassLinks/{id} {
      // resource is null for a doc that doesn't exist yet (e.g. a student
      // created before this collection existed) — `resource.data` on that
      // throws, not just evaluates false, so the null case must be handled
      // before touching `.data` (same pattern as timetableGrids below).
      // Existence alone reveals nothing, so any signed-in user may learn
      // "no link here yet."
      allow read: if resource == null || isAdminOfSchool(resource.data.schoolId) || request.auth.uid == resource.data.parentUid;
      allow create, update: if isAdminOfSchool(request.resource.data.schoolId) || isClassTeacherOf(request.resource.data.classSectionId);
      allow delete: if resource == null || isAdminOfSchool(resource.data.schoolId) || isClassTeacherOf(resource.data.classSectionId);
    }

    // -----------------------------------------------------------------------
    // students/{id}
    // -----------------------------------------------------------------------

    // Reads: any teacher of the class (Class or Subject Teacher, per
    // isAnyTeacherOf's interim "any faculty of the school" definition above)
    // or the student's own guardian. Writes (create/update/delete) are
    // tighter — only the real, admin-assigned Class Teacher of that
    // classSectionId, via isClassTeacherOf() — matching "only the Class
    // Teacher can add/edit/delete their own students".
    match /students/{studentId} {
      allow get: if isAdminOfSchool(resource.data.schoolId) ||
        isAnyTeacherOf(resource.data.classSectionId) ||
        (request.auth.uid in resource.data.guardianUids);

      allow list: if isAdminOfSchool(resource.data.schoolId) ||
        isAnyTeacherOf(resource.data.classSectionId) ||
        (request.auth.uid in resource.data.guardianUids);

      allow create: if isAdminOfSchool(request.resource.data.schoolId) ||
        isClassTeacherOf(request.resource.data.classSectionId);

      allow update: if isAdminOfSchool(resource.data.schoolId) ||
        isClassTeacherOf(resource.data.classSectionId);

      allow delete: if isAdminOfSchool(resource.data.schoolId) ||
        isClassTeacherOf(resource.data.classSectionId);
    }

    // -----------------------------------------------------------------------
    // attendance/{studentId_date}
    // -----------------------------------------------------------------------

    match /attendance/{id} {
      allow read: if isAdminOfSchool(resource.data.schoolId) ||
        isAnyTeacherOf(resource.data.classSectionId) ||
        isGuardianOf(resource.data.studentId);

      // Only the real Class Teacher of this class-section may create —
      // Admin dropped from create (Admin is read-only reporting per the
      // Attendance spec) and Subject Teachers already excluded
      // (isClassTeacherOf, not isAnyTeacherOf). No update/delete for anyone,
      // ever: previous attendance can never be modified. Because Firestore's
      // create-vs-update branch is decided by whether the doc id already
      // existed (not by which client method was called), a resubmit attempt
      // on the same studentId_date via setDoc() is evaluated as `update` and
      // denied here — this is what makes "only once per class per day"
      // actually enforced server-side, not just a client-side check. Note:
      // this does NOT verify request.resource.data.date is actually today —
      // see CLAUDE.md "Known debts" for why that's deliberately left as an
      // application-level check only.
      allow create: if isClassTeacherOf(request.resource.data.classSectionId) &&
        request.resource.data.markedByUid == request.auth.uid;

      allow update, delete: if false;
    }

    // -----------------------------------------------------------------------
    // attendanceSummaries/{classSectionId_date}
    // -----------------------------------------------------------------------
    // One immutable doc per class per date — see lib/types.ts AttendanceSummary
    // for why this exists alongside attendance/{id}. Never read by parents;
    // they read their own child's attendance/{id} docs directly via
    // isGuardianOf above.

    // Parsed from the doc id (not read off resource.data) so a direct get()
    // on a NOT-YET-EXISTING summary doc (the Dashboard's "today" check, true
    // every day before attendance is taken) can still be authorized: resource
    // is null for a get() on a nonexistent doc, and referencing
    // resource.data.anything on it throws, which on its own would be treated
    // as a denial. Kept alongside (not instead of) the resource.data-based
    // checks below: those are what let the History LIST query (filtered by
    // the classSectionId FIELD) be statically proven safe — a check based on
    // the document id can't be correlated with a field-equality filter, so
    // list would be denied outright without them. Firestore's `||` is
    // error-tolerant (true if ANY operand is true, even if another operand
    // throws), so combining both here is safe for both access patterns.
    function summaryClassSectionId(id) {
      return id.split('_')[0];
    }

    match /attendanceSummaries/{id} {
      allow read: if isAdminOfSchool(resource.data.schoolId) ||
        isAnyTeacherOf(resource.data.classSectionId) ||
        isAdminOfSchool(classSectionDoc(summaryClassSectionId(id)).data.schoolId) ||
        isAnyTeacherOf(summaryClassSectionId(id));

      allow create: if isClassTeacherOf(request.resource.data.classSectionId) &&
        request.resource.data.teacherUid == request.auth.uid;

      allow update, delete: if false;
    }

    // -----------------------------------------------------------------------
    // holidays/{schoolId_date} — declared by the Admin, school-wide (see
    // lib/types.ts Holiday). NOT in the isSchoolScopedAdminCollection bucket
    // even though the read/write shape matches it exactly: Take
    // Attendance/the Dashboard do a direct get() on TODAY's doc every day,
    // and most days aren't a holiday — that get() hits a nonexistent doc far
    // more often than not, making `resource` null. The bucket's shared read
    // rule only checks resource.data.schoolId with no null-resource
    // fallback, so it throws (permission-denied) on exactly the common case.
    // Parsing schoolId from the id instead (same trick as
    // summaryClassSectionId above) avoids resource.data entirely on read, so
    // it works whether or not the doc exists. Every Sunday is a holiday by
    // default at the application level (see lib/holidays.ts's
    // isDefaultHoliday) without needing a stored doc at all.
    // -----------------------------------------------------------------------

    function holidaySchoolId(id) {
      return id.split('_')[0];
    }

    // Needs BOTH branches below, same reasoning as attendanceSummaries
    // above: the id-parsed branch covers a direct get() on TODAY's holiday
    // doc (usually nonexistent, resource == null, so the check must avoid
    // touching resource.data) — the Faculty Attendance pages' use case. The
    // resource.data branch is what makes the Admin Holidays calendar's
    // ranged LIST query (filtered by the schoolId FIELD) provable — a check
    // based on the document id can't be correlated with a field-equality
    // filter, so that list would be denied outright without it. Firestore's
    // `||` is error-tolerant, so combining both here is safe for both access
    // patterns, exactly like attendanceSummaries.
    match /holidays/{id} {
      allow read: if isSuperAdmin() ||
        inSameSchool(holidaySchoolId(id)) ||
        inSameSchool(resource.data.schoolId);

      allow create, update: if isAdminOfSchool(request.resource.data.schoolId);

      allow delete: if isAdminOfSchool(resource.data.schoolId);
    }

    // -----------------------------------------------------------------------
    // assignments/{id} — Classwork/Homework diary. Written by the specific
    // Subject Teacher assigned to that class-section+subject (via
    // facultyAssignments, see isSubjectTeacherOf above); read by any staff
    // of the school plus the class's linked parents.
    // -----------------------------------------------------------------------

    match /assignments/{id} {
      allow read: if isAdminOfSchool(resource.data.schoolId) ||
        isAnyTeacherOf(resource.data.classSectionId) ||
        isParentLinkedToClass(resource.data.classSectionId);

      allow create, update: if isAdminOfSchool(request.resource.data.schoolId) ||
        isSubjectTeacherOf(request.resource.data.classSectionId, request.resource.data.subjectId);

      allow delete: if isAdminOfSchool(resource.data.schoolId) ||
        isSubjectTeacherOf(resource.data.classSectionId, resource.data.subjectId);
    }

    // -----------------------------------------------------------------------
    // achievements/{id} — Class Teacher only, student-scoped
    // -----------------------------------------------------------------------

    match /achievements/{id} {
      allow read: if isAdminOfSchool(resource.data.schoolId) ||
        isAnyTeacherOf(resource.data.classSectionId) ||
        isGuardianOf(resource.data.studentId);

      allow create, update: if isAdminOfSchool(request.resource.data.schoolId) ||
        isClassTeacherOf(request.resource.data.classSectionId);

      allow delete: if isAdminOfSchool(resource.data.schoolId) ||
        isClassTeacherOf(resource.data.classSectionId);
    }

    // -----------------------------------------------------------------------
    // assessments/{id} — Subject Teacher-conducted quizzes/competitions.
    // Class-scoped like assignments/{id} (not per-student) — see
    // lib/types.ts Assessment. Written by the specific Subject Teacher
    // assigned to that class-section+subject (via facultyAssignments), same
    // as assignments/{id} — tightened from the old isAnyTeacherOf
    // placeholder now that real per-subject assignment data exists.
    // -----------------------------------------------------------------------

    match /assessments/{id} {
      allow read: if isAdminOfSchool(resource.data.schoolId) ||
        isAnyTeacherOf(resource.data.classSectionId) ||
        isParentLinkedToClass(resource.data.classSectionId);

      allow create, update: if isAdminOfSchool(request.resource.data.schoolId) ||
        isSubjectTeacherOf(request.resource.data.classSectionId, request.resource.data.subjectId);

      allow delete: if isAdminOfSchool(resource.data.schoolId) ||
        isSubjectTeacherOf(resource.data.classSectionId, resource.data.subjectId);
    }

    // -----------------------------------------------------------------------
    // academicRecords/{id} — "Academics": formal exam marks per student per
    // subject (Parent "Academics" page), entered by the Subject Teacher of
    // that subject — see lib/types.ts AcademicRecord. Student-scoped (unlike
    // assessments above), same write gate as assignments/assessments.
    // -----------------------------------------------------------------------

    match /academicRecords/{id} {
      allow read: if isAdminOfSchool(resource.data.schoolId) ||
        isAnyTeacherOf(resource.data.classSectionId) ||
        isGuardianOf(resource.data.studentId);

      allow create, update: if isAdminOfSchool(request.resource.data.schoolId) ||
        isSubjectTeacherOf(request.resource.data.classSectionId, request.resource.data.subjectId);

      allow delete: if isAdminOfSchool(resource.data.schoolId) ||
        isSubjectTeacherOf(resource.data.classSectionId, resource.data.subjectId);
    }

    // parentRequests/{id} and leaveRequests/{id} are handled by the
    // isParentReviewedRequestCollection() bucket above. That bucket's
    // `{collection}/{id}` wildcard match does NOT reach into a subcollection
    // path like parentRequests/{id}/replies/{replyId} — Firestore rules
    // matches are path-exact, so the "Conversation Timeline" reply thread on
    // a request's detail panel needs its own dedicated block, same shape as
    // conversations/{id}/messages below. Unlike the parent doc itself (only
    // Admin/Class Teacher can update it, e.g. to change status), the owning
    // parent CAN post replies here even though they can't touch the parent
    // doc directly.
    match /parentRequests/{requestId}/replies/{replyId} {
      function parentRequestDoc() {
        return get(/databases/$(database)/documents/parentRequests/$(requestId));
      }

      allow read: if isAdminOfSchool(parentRequestDoc().data.schoolId) ||
        isClassTeacherOf(parentRequestDoc().data.classSectionId) ||
        request.auth.uid == parentRequestDoc().data.parentUid;

      allow create: if (
        isAdminOfSchool(parentRequestDoc().data.schoolId) ||
        isClassTeacherOf(parentRequestDoc().data.classSectionId) ||
        request.auth.uid == parentRequestDoc().data.parentUid
      ) && request.resource.data.senderUid == request.auth.uid;
    }

    // -----------------------------------------------------------------------
    // conversations/{id} + messages subcollection — Class Teacher <-> Parent only
    // -----------------------------------------------------------------------

    match /conversations/{id} {
      allow read: if isAdminOfSchool(resource.data.schoolId) ||
        request.auth.uid in resource.data.participantUids;

      allow create: if request.auth.uid in request.resource.data.participantUids &&
        (isClassTeacherOf(request.resource.data.classSectionId) || isGuardianOf(request.resource.data.studentId));

      allow update: if isAdminOfSchool(resource.data.schoolId) ||
        request.auth.uid in resource.data.participantUids;

      allow delete: if isAdminOfSchool(resource.data.schoolId);

      match /messages/{messageId} {
        allow read: if isAdminOfSchool(get(/databases/$(database)/documents/conversations/$(id)).data.schoolId) ||
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(id)).data.participantUids;

        allow create: if request.auth.uid in get(/databases/$(database)/documents/conversations/$(id)).data.participantUids &&
          request.resource.data.senderUid == request.auth.uid;
      }
    }

    // -----------------------------------------------------------------------
    // announcements/{id} — Class Teacher writes, class's linked parents read
    // -----------------------------------------------------------------------

    match /announcements/{id} {
      allow read: if isAdminOfSchool(resource.data.schoolId) ||
        isClassTeacherOf(resource.data.classSectionId) ||
        isParentLinkedToClass(resource.data.classSectionId);

      allow create, update: if isAdminOfSchool(request.resource.data.schoolId) ||
        isClassTeacherOf(request.resource.data.classSectionId);

      allow delete: if isAdminOfSchool(resource.data.schoolId) ||
        isClassTeacherOf(resource.data.classSectionId);
    }

    // circulars/{id}, events/{id}, activities/{id} and transportBuses/{id} are
    // handled by the isSchoolScopedAdminCollection() bucket above.

    // -----------------------------------------------------------------------
    // timetables/{classSectionId} — scoped to that class's faculty + parents
    // -----------------------------------------------------------------------

    match /timetables/{classSectionId} {
      allow read: if isAdminOfSchool(resource.data.schoolId) ||
        isAnyTeacherOf(classSectionId) ||
        isParentLinkedToClass(classSectionId);

      allow create, update: if isAdminOfSchool(request.resource.data.schoolId);
      allow delete: if isAdminOfSchool(resource.data.schoolId);
    }

    // -----------------------------------------------------------------------
    // timetableGrids/{id} — grid-editor Timetable module (app/admin/timetable,
    // lib/timetable*.ts). Keyed by the real classSections/{id} doc id (see
    // isSchoolScopedAdminCollection's 'classSections' entry above) — each
    // class section owns exactly one independent timetable doc (its own
    // days, periods, breaks, cells). Sections themselves are shared with the
    // rest of the app (classSections/{id}) — the module's own
    // timetableSections/timetableConfigs collections were removed once
    // Admin · Classes became the single place sections are created/deleted.
    // This is also read by Faculty (own sections + browsing) and Parent
    // (linked student's section) — both read-only, only once a timetable is
    // published.
    // NOT YET RECONCILED with timetables/{classSectionId} above (the
    // Excel-upload design from docs/context.md Tab 3) — two parallel
    // Timetable designs currently coexist; pick one before building
    // anything further on top of that one.
    // -----------------------------------------------------------------------

    // Drafts are admin-only; published timetables are readable by anyone in
    // the same school (Faculty/Parent timetable pages read this directly).
    // A section with no timetable yet has no document at all — `resource` is
    // null in that case, so the "not created yet" check must come first (any
    // signed-in user may learn that nothing exists there; no data is
    // exposed) before touching resource.data, or the missing-doc read errors
    // out as permission-denied instead of returning "not found".
    match /timetableGrids/{gridId} {
      allow read: if (resource == null && isSignedIn()) || (resource != null && (
        isAdminOfSchool(resource.data.schoolId) ||
        (inSameSchool(resource.data.schoolId) && resource.data.status == 'published')
      ));
      allow create, update: if isAdminOfSchool(request.resource.data.schoolId);
      allow delete: if resource == null || isAdminOfSchool(resource.data.schoolId);
    }

    // feeStructures/{id} is handled by the isSchoolScopedAdminCollection()
    // bucket above (unlike studentFees below, the class-level fee schedule
    // isn't sensitive per-student data).

    // -----------------------------------------------------------------------
    // studentFees/{studentId} — sensitive, guardian-only read (+ admin/Class
    // Teacher). Class Teacher write is for the negotiated final fee — Admin
    // sets the class-wide feeStructures default, the Class Teacher may then
    // adjust an individual student's discount/payable after negotiation.
    // -----------------------------------------------------------------------

    // Read resolves schoolId/classSectionId via the always-existing
    // students/{studentId} doc, not studentFees' own (possibly nonexistent)
    // resource.data — a student with no fee configured yet is the common
    // case (right after Add Student, before Admin sets discounts), and a
    // direct get() on that doc has resource == null then. Touching
    // resource.data.schoolId in that case throws — isGuardianOf already
    // sidesteps this (it goes via studentDoc independently), but the
    // admin/class-teacher branches didn't, and had no fallback, so opening a
    // new student's fee detail as Admin denied the read outright.
    match /studentFees/{studentId} {
      allow read: if isAdminOfSchool(studentDoc(studentId).data.schoolId) ||
        isGuardianOf(studentId) ||
        isClassTeacherOf(studentDoc(studentId).data.classSectionId);

      allow create, update: if isAdminOfSchool(request.resource.data.schoolId) ||
        isClassTeacherOf(request.resource.data.classSectionId);

      allow delete: if isAdminOfSchool(resource.data.schoolId);
    }

    // -----------------------------------------------------------------------
    // documents/{id} — parent uploads own child's docs, admin verifies,
    // class teacher views only
    // -----------------------------------------------------------------------

    match /documents/{id} {
      allow read: if isAdminOfSchool(resource.data.schoolId) ||
        isClassTeacherOf(get(/databases/$(database)/documents/students/$(resource.data.studentId)).data.classSectionId) ||
        request.auth.uid == resource.data.uploadedByUid;

      allow create: if isGuardianOf(request.resource.data.studentId) &&
        request.resource.data.uploadedByUid == request.auth.uid &&
        request.resource.data.verificationStatus == 'pending';

      allow update: if isAdminOfSchool(resource.data.schoolId);

      allow delete: if isAdminOfSchool(resource.data.schoolId) ||
        request.auth.uid == resource.data.uploadedByUid;
    }

    // -----------------------------------------------------------------------
    // documentRequirements/{classSectionId} — which DocumentTypes the Class
    // Teacher (or Admin) has opened up for parents to upload for this
    // section — see lib/types.ts DocumentRequirement. Doesn't fit either
    // extensible bucket (keyed by classSectionId, and Class Teacher — not
    // just Admin — can write it), so it's a dedicated block, same shape as
    // announcements above. The doc id IS the classSectionId, and a section
    // with no requirements configured yet has no doc at all — the read
    // rule's admin branch resolves schoolId via classSectionDoc(classSectionId)
    // (a real, always-existing doc) rather than resource.data.schoolId, so a
    // direct get() on a not-yet-created config doc doesn't throw (same class
    // of gotcha the holidays block above works around).
    // -----------------------------------------------------------------------

    match /documentRequirements/{classSectionId} {
      allow read: if isAdminOfSchool(classSectionDoc(classSectionId).data.schoolId) ||
        isAnyTeacherOf(classSectionId) ||
        isParentLinkedToClass(classSectionId);

      allow create, update: if isAdminOfSchool(request.resource.data.schoolId) ||
        isClassTeacherOf(classSectionId);

      allow delete: if isAdminOfSchool(classSectionDoc(classSectionId).data.schoolId) ||
        isClassTeacherOf(classSectionId);
    }
  }
}
