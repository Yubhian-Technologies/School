rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isSignedIn() && myProfile().role == 'superadmin';
    }

    function isAdminOfSchool(schoolId) {
      return isSignedIn() && myProfile().role == 'admin' && myProfile().schoolId == schoolId;
    }

    function inSameSchool(schoolId) {
      return isSignedIn() && myProfile().schoolId == schoolId;
    }

    function isGuardianOfStudent(schoolId, studentId) {
      return isSignedIn() && myProfile().role == 'parent' && myProfile().schoolId == schoolId &&
        request.auth.uid in firestore.get(/databases/(default)/documents/students/$(studentId)).data.guardianUids;
    }

    function isFacultyOfSchool(schoolId) {
      return isSignedIn() && myProfile().role == 'faculty' && myProfile().schoolId == schoolId;
    }

    // Raised from 10MB — modern phone cameras routinely produce 10-15MB
    // photos, and a profile-photo upload silently failing against a too-low
    // cap looks exactly like a generic "Firebase error" to the user.
    function isReasonableUpload() {
      return request.resource.size < 20 * 1024 * 1024;
    }

    // ---------------------------------------------------------------------
    // EXTENDING THIS FILE — mirrors firestore.rules' bucket-registry
    // pattern. Most new upload categories are one of two shapes:
    //   - admin-authored, school-wide read (circulars, timetables, events...)
    //   - admin/faculty-authored, school-wide read (assignments,
    //     achievements...)
    // For either shape, add the folder name to the matching list below —
    // nothing else needs to change, and this file (a separate Firebase
    // Console publish step from firestore.rules) doesn't need touching
    // again for that new feature. Only a genuinely new access pattern
    // (parent-authored, per-student scoped, etc. — like students/{id} and
    // faculty/{uid} below) needs its own dedicated match block.
    // ---------------------------------------------------------------------

    function isAdminAuthoredCategory(category) {
      return category in ['circulars', 'timetables', 'events'];
    }

    function isStaffAuthoredCategory(category) {
      return category in ['assignments', 'achievements'];
    }

    // Student photos + documents (Aadhaar, birth cert, medical cert, etc.).
    // Faculty write access is needed so a Class Teacher can add/edit a
    // student's photo and digital ID (firestore.rules already trusts any
    // faculty of the school the same way, via isFacultyOfSchool/isAnyTeacherOf).
    match /schools/{schoolId}/students/{studentId}/{allPaths=**} {
      allow read: if isSuperAdmin() || isAdminOfSchool(schoolId) || inSameSchool(schoolId) ||
        isGuardianOfStudent(schoolId, studentId);

      allow write: if isReasonableUpload() && (
        isAdminOfSchool(schoolId) || isFacultyOfSchool(schoolId) || isGuardianOfStudent(schoolId, studentId)
      );
    }

    // Faculty photos
    match /schools/{schoolId}/faculty/{uid}/{allPaths=**} {
      allow read: if isSuperAdmin() || inSameSchool(schoolId);
      allow write: if isReasonableUpload() && (isAdminOfSchool(schoolId) || request.auth.uid == uid);
    }

    // Bucket: admin-authored categories (circulars, timetable Excel
    // uploads, event photos) — admin-of-school write, school-wide read. New
    // members: add the folder name to isAdminAuthoredCategory() above.
    match /schools/{schoolId}/{category}/{allPaths=**} {
      allow read: if isAdminAuthoredCategory(category) && (isSuperAdmin() || inSameSchool(schoolId));
      allow write: if isAdminAuthoredCategory(category) && isReasonableUpload() && isAdminOfSchool(schoolId);
    }

    // Bucket: admin/faculty-authored categories (assignment and achievement
    // attachments) — admin-or-faculty-of-school write, school-wide read.
    // New members: add the folder name to isStaffAuthoredCategory() above.
    // Faculty check is scoped by schoolId (isFacultyOfSchool), not just
    // role — a bare myProfile().role == 'faculty' check here previously let
    // any faculty account write into ANY school's assignments/achievements
    // folder, not just their own.
    match /schools/{schoolId}/{category}/{allPaths=**} {
      allow read: if isStaffAuthoredCategory(category) && (isSuperAdmin() || inSameSchool(schoolId));
      allow write: if isStaffAuthoredCategory(category) && isReasonableUpload() &&
        (isAdminOfSchool(schoolId) || isFacultyOfSchool(schoolId));
    }

    // Deny everything else by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
